# ──────────────────────────────────────────────────────────────────────────────
# springAIMcpServerCommon — local dev environment variables
# Copy to .env and fill in values before running docker compose.
# .env is git-ignored; never commit real secrets.
# ──────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=dai_store
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres_secret      # change for shared environments
POSTGRES_MIGRATOR_USER=dai_migrator
POSTGRES_MIGRATOR_PASSWORD=dai_migrator_secret   # CHANGE ME
POSTGRES_APP_USER=dai_app
POSTGRES_APP_PASSWORD=dai_app_secret             # CHANGE ME
POSTGRES_EXTERNAL_PORT=5432                      # change if 5432 is taken on your Mac

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=redis_secret                      # CHANGE ME
REDIS_MAX_MEMORY=256mb
REDIS_EXTERNAL_PORT=6379

# ── Ollama (local AI) ─────────────────────────────────────────────────────────
# Pull once with: docker compose run --rm ollama-pull
# Suggested models (pick one based on Mac RAM):
#   qwen2.5:3b   —  ~2 GB, fast on M1/M2, good for smoke testing
#   llama3.2:3b  —  ~2 GB, Meta's latest 3B
#   qwen2.5:7b   —  ~4.5 GB, better quality, needs 8 GB+ free VRAM
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_EXTERNAL_PORT=11434

# ── Demo app ──────────────────────────────────────────────────────────────────
APP_PORT=8080
APP_MEMORY_LIMIT=1g
DEMO_USER=admin
DEMO_PASSWORD=change_me                          # CHANGE ME

# ── Library config ────────────────────────────────────────────────────────────
# dev | staging | prod   (prod locks the admin UI and disables authoring)
DAI_ENV_TIER=dev

# ── Cloud AI API integration (app-api service / 'api' Spring profile) ────────
#
# Select the provider:
#   AI_PROVIDER=openai     — OpenAI GPT models (default)
#   AI_PROVIDER=anthropic  — Anthropic Claude models
#
AI_PROVIDER=openai

# ── OpenAI ────────────────────────────────────────────────────────────────────
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=                              # sk-...   REQUIRED for openai provider
OPENAI_BASE_URL=https://api.openai.com       # override for Azure OpenAI or a local proxy
# Recommended models for testing (cost ↑ = quality ↑):
#   gpt-4o-mini   — cheapest, fast, good for smoke tests
#   gpt-4o        — higher quality, production-grade
#   o3-mini       — reasoning model
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Anthropic Claude ──────────────────────────────────────────────────────────
# Get your key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=                           # sk-ant-... REQUIRED for anthropic provider
# Recommended models:
#   claude-haiku-4-5-20251001  — cheapest, fast
#   claude-sonnet-5            — balanced (default)
#   claude-opus-5-5            — highest quality
ANTHROPIC_CHAT_MODEL=claude-sonnet-5

# ── Shared AI tuning ─────────────────────────────────────────────────────────
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=4096

# ── app-api service port ──────────────────────────────────────────────────────
APP_API_PORT=8081

# ── Neo4j graph store (profile: graph) ────────────────────────────────────────
# Start: docker compose --profile graph up -d neo4j
# Then init schema once: docker compose --profile graph run --rm neo4j-init
# Browser UI: http://localhost:7474

NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_secret                  # CHANGE ME
NEO4J_DATABASE=neo4j                         # default database name in Community Edition
NEO4J_HTTP_PORT=7474                         # Browser / REST
NEO4J_BOLT_PORT=7687                         # Bolt (driver / Spring Data)

# ── Neo4j tuning (adjust based on Mac RAM) ────────────────────────────────────
# 8 GB Mac:  512m / 1g / 512m
# 16 GB Mac: 1g   / 2g / 1g
NEO4J_HEAP_INITIAL=512m
NEO4J_HEAP_MAX=1g
NEO4J_PAGECACHE=512m

# ── Graph retrieval tuning ────────────────────────────────────────────────────
# Vector index dimension — must match spring.ai.vectorstore.neo4j.embedding-dimension
# and the CREATE VECTOR INDEX statements in docker/neo4j/init/01_schema.cypher.
# 1536 = OpenAI text-embedding-3-small / ada-002
# 3072 = OpenAI text-embedding-3-large
# 1024 = Anthropic voyage-3
NEO4J_EMBEDDING_DIMENSION=1536
NEO4J_TOP_K=5                                # context nodes retrieved per query
NEO4J_MIN_SCORE=0.70                         # cosine similarity threshold
NEO4J_TURN_RETENTION_DAYS=90                 # archive turns older than this

# ── app-graph service port ────────────────────────────────────────────────────
APP_GRAPH_PORT=8082

# ── H2 console (test profile only) ───────────────────────────────────────────
H2_CONSOLE_PORT=8082
