# Local rule-engine ecosystem. `scripts/rule-engine/dev.sh up` creates .env from this list with RANDOM secrets on first run;
# copy it by hand only if you want to pin values. .env is git-ignored. NEVER reuse any of this outside a developer machine.

# HMAC key (>= 32 bytes) that signs access tokens: the auth service signs, the rule-engine service verifies
JWT_SECRET=

POSTGRES_DB=dai_store
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=
RULES_APP_PASSWORD=
RULES_MIGRATOR_PASSWORD=
AUTH_DB_PASSWORD=
GRAFANA_RO_PASSWORD=

# seeded UI logins (tenant "Acme Bank": admin = ADMIN, user = USER, both in organization "Retail")
SEED_ADMIN_PASSWORD=admin123
SEED_USER_PASSWORD=user123

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# AI assistant: leave empty for the built-in offline assistant (no language model). For Claude, set all three:
#   ANTHROPIC_API_KEY=sk-ant-...   SPRING_AI_MODEL_CHAT=anthropic   ASSISTANT_PROVIDER=anthropic
ANTHROPIC_API_KEY=
SPRING_AI_MODEL_CHAT=none
ASSISTANT_PROVIDER=offline

# host ports (all bound to 127.0.0.1)
RE_UI_PORT=8080
RE_UI_NG_PORT=8081
RE_AUTH_PORT=8091
RE_RULES_PORT=8092
RE_GRAFANA_PORT=3000
RE_PROMETHEUS_PORT=9090
RE_LOKI_PORT=3100
RE_PG_PORT=55433
