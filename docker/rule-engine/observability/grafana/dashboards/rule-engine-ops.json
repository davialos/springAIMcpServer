          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT r.error_code, count(*) AS n FROM dynamic_ai.dai_re_evaluation_result r JOIN dynamic_ai.dai_re_evaluation e ON e.id = r.evaluation_id WHERE r.outcome = 'ERROR' AND $__timeFilter(e.evaluated_at) GROUP BY 1 ORDER BY 2 DESC"
