      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Decisions over time",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "rules-db"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "rules-db"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT $__timeGroupAlias(evaluated_at, $__interval), decision AS metric, count(*) AS value FROM dynamic_ai.dai_re_evaluation WHERE $__timeFilter(evaluated_at) GROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 14,
        "x": 0,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "ALLOW"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "WARN"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "BLOCK"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 9,
      "type": "barchart",
      "title": "Decisions by rule group",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "rules-db"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "rules-db"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT g.code AS rule_group, count(*) FILTER (WHERE e.decision = 'ALLOW') AS \"ALLOW\", count(*) FILTER (WHERE e.decision = 'WARN') AS \"WARN\", count(*) FILTER (WHERE e.decision = 'BLOCK') AS \"BLOCK\" FROM dynamic_ai.dai_re_evaluation e JOIN dynamic_ai.dai_re_rule_group g ON g.id = e.rule_group_id WHERE $__timeFilter(e.evaluated_at) GROUP BY 1 ORDER BY 1"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 10,
        "x": 14,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "ALLOW"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "WARN"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "BLOCK"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "stacking": "normal",
        "xField": "rule_group",
        "xTickLabelRotation": -45,
        "xTickLabelMaxLength": 14,
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 10,
      "type": "table",
      "title": "Rules that fail or error the most",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "rules-db"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "rules-db"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT ru.code AS rule, count(*) FILTER (WHERE r.outcome = 'FALSE') AS false_results, count(*) FILTER (WHERE r.outcome = 'ERROR') AS errors, count(*) AS evaluated FROM dynamic_ai.dai_re_evaluation_result r JOIN dynamic_ai.dai_re_evaluation e ON e.id = r.evaluation_id JOIN dynamic_ai.dai_re_rule ru ON ru.id = r.rule_id WHERE $__timeFilter(e.evaluated_at) GROUP BY 1 ORDER BY errors DESC, false_results DESC LIMIT 15"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
