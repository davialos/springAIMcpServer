          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT count(*) AS failed FROM re_auth.re_auth_login_event WHERE outcome <> 'SUCCESS' AND $__timeFilter(occurred_at)"
