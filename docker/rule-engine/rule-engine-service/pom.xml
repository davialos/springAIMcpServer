<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.springaimcpservercommon.ecosystem</groupId>
        <artifactId>rule-engine-ecosystem</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <!--
      Rule-engine microservice of the local ecosystem (ADR-0026): embeds the CEL rule engine library (ADR-0025) and
      exposes the reference authoring/evaluation/admin-log REST API (OQ-65). Scope (tenant, organization) comes only from
      the signed access token. Runs the library's own migrations (V1..V12) with Flyway and embeds the starter for the AI assistant (agent runtime,
      /dynamic-ai chat and admin APIs, ADR-0027); the rule engine itself still uses plain JDBC.
    -->
    <artifactId>rule-engine-service</artifactId>
    <name>springAIMcpServerCommon :: Rule-engine service</name>

    <dependencies>
        <dependency>
            <groupId>com.springaimcpservercommon.ecosystem</groupId>
            <artifactId>rule-engine-contract</artifactId>
        </dependency>
        <!-- the library: the engine, and the Flyway migrations (db/dynamic-ai/migration) it needs -->
        <dependency>
            <groupId>com.springaimcpservercommon</groupId>
            <artifactId>spring-ai-mcp-server-common-ruleengine</artifactId>
            <version>${library.version}</version>
        </dependency>
        <!-- the starter: persistence unit + migrations, the agent runtime, the /dynamic-ai chat and admin APIs (ADR-0027) -->
        <dependency>
            <groupId>com.springaimcpservercommon</groupId>
            <artifactId>spring-ai-mcp-server-common-spring-boot-starter</artifactId>
            <version>${library.version}</version>
        </dependency>
        <!-- the real model: active only when SPRING_AI_MODEL_CHAT=anthropic and ANTHROPIC_API_KEY are set; otherwise the built-in
             offline assistant answers (AssistantModels). Another provider = another spring-ai-starter-model-* here. -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-anthropic</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>rule-engine-service</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
