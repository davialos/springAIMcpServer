# The Angular console's web server: serves the built app and forwards /auth, /api and /dynamic-ai to the services, so the
# browser sees ONE origin (no CORS). ${AUTH_UPSTREAM} and ${RULES_UPSTREAM} are substituted by the nginx image at start.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;

    include /etc/nginx/security-headers.conf;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location /auth/ {
        client_max_body_size 8k;
        proxy_pass http://${AUTH_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 15s;
        proxy_hide_header X-Frame-Options;
        proxy_hide_header X-Content-Type-Options;
        include /etc/nginx/security-headers.conf;
    }

    location /api/ {
        client_max_body_size 300k;
        proxy_pass http://${RULES_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
        proxy_hide_header X-Frame-Options;
        proxy_hide_header X-Content-Type-Options;
        include /etc/nginx/security-headers.conf;
    }

    # the AI assistant: the library's agent runtime streams its answer as Server-Sent Events, so nothing may buffer it
    location /dynamic-ai/api/agents/ {
        client_max_body_size 16k;
        proxy_pass http://${RULES_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        gzip off;
        proxy_read_timeout 120s;
        proxy_hide_header X-Frame-Options;
        proxy_hide_header X-Content-Type-Options;
        include /etc/nginx/security-headers.conf;
    }

    # everything else under /dynamic-ai (the library's admin API, MCP, ...) is NOT reachable from the browser through here
    location /dynamic-ai/ {
        return 404;
    }

    location /assets/ {
        try_files $uri =404;
    }

    # hashed build files never change under the same name
    location ~* \.(?:js|css)$ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        include /etc/nginx/security-headers.conf;
        try_files $uri =404;
    }

    # single-page app: every other path is the app; the entry document is never cached
    location / {
        add_header Cache-Control "no-store";
        include /etc/nginx/security-headers.conf;
        try_files $uri /index.html;
    }
}
