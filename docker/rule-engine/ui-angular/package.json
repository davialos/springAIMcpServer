{
  "name": "rule-engine-console-angular",
  "version": "0.1.0",
  "scripts": {
    "proto": "node -e \"require('fs').mkdirSync('src/app/core/proto/gen',{recursive:true})\" && pbjs -t static-module -w es6 -o src/app/core/proto/gen/session.js ../contract/src/main/protobuf/springaimcp/ruleengine/v1/session.proto && pbts -o src/app/core/proto/gen/session.d.ts src/app/core/proto/gen/session.js",
    "ng": "ng",
    "start": "npm run proto && ng serve --port 4200",
    "build": "npm run proto && ng build",
    "test": "npm run proto && ng test --watch=false",
    "e2e": "playwright test"
  },
  "private": true,
  "packageManager": "npm@10.9.4",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "protobufjs": "^8.8.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.25",
    "@angular/cli": "^21.2.25",
    "@angular/compiler-cli": "^21.2.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8",
    "protobufjs-cli": "^2.7.0",
    "@playwright/test": "^1.63.0"
  }
}
