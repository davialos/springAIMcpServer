# The console's web server: serves the built UI and forwards /auth and /api to the two services, so the browser sees ONE origin
# (no CORS, no service ports exposed to the page). ${AUTH_UPSTREAM} and ${RULES_UPSTREAM} are substituted by the nginx image
# at start (host:port of the services on the compose network).
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;

    include /etc/nginx/security-headers.conf;

    # health of the web server itself (compose healthcheck)
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # the login endpoint: small protobuf bodies only
    location /auth/ {
        client_max_body_size 8k;
        proxy_pass http://${AUTH_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 15s;
        # the headers come from security-headers.conf only (one owner), not twice
        proxy_hide_header X-Frame-Options;
        proxy_hide_header X-Content-Type-Options;
        include /etc/nginx/security-headers.conf;
    }

    # the rule-engine API; the service enforces its own limit (256 KB), this one stops it earlier
    location /api/ {
        client_max_body_size 300k;
        proxy_pass http://${RULES_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
        proxy_hide_header X-Frame-Options;
        proxy_hide_header X-Content-Type-Options;
        include /etc/nginx/security-headers.conf;
    }

    # hashed build assets never change under the same name
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        include /etc/nginx/security-headers.conf;
        try_files $uri =404;
    }

    # single-page app: every other path is the app; the entry document is never cached
    location / {
        add_header Cache-Control "no-store";
        include /etc/nginx/security-headers.conf;
        try_files $uri /index.html;
    }
}
