{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dynamic-ai/schemas/dai-tools-1.schema.json",
  "title": "dai-tools/1: ask_user and render_ui arguments, restricted response schema (LLD-17)",
  "description": "Normative draft. askUserInput and renderUiInput are the inputSchema of the two control tools; responseSchema is stored with a question interrupt.",
  "oneOf": [
    {
      "$ref": "#/$defs/askUserInput"
    },
    {
      "$ref": "#/$defs/renderUiInput"
    },
    {
      "$ref": "#/$defs/responseSchema"
    }
  ],
  "$defs": {
    "askOption": {
      "type": "object",
      "required": [
        "value",
        "label"
      ],
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "additionalProperties": false
    },
    "askField": {
      "type": "object",
      "required": [
        "name",
        "label",
        "type"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][A-Za-z0-9_]{0,39}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "type": {
          "enum": [
            "text",
            "number",
            "integer",
            "boolean",
            "choice",
            "multi_choice",
            "date",
            "datetime"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "help": {
          "type": "string",
          "maxLength": 300
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "maxItems": 25,
          "items": {
            "$ref": "#/$defs/askOption"
          }
        },
        "minLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2000
        },
        "maxLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "format": {
          "enum": [
            "email",
            "uri"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "choice",
                  "multi_choice"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "options"
            ],
            "properties": {
              "options": true
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "askUserInput": {
      "type": "object",
      "required": [
        "question"
      ],
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/askField"
          }
        },
        "confirm": {
          "type": "object",
          "properties": {
            "accept": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            },
            "decline": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            }
          },
          "additionalProperties": false
        }
      },
      "not": {
        "required": [
          "fields",
          "confirm"
        ],
        "properties": {
          "fields": true,
          "confirm": true
        }
      },
      "additionalProperties": false,
      "description": "Arguments of the ask_user control tool. No fields and no confirm = one free-text answer."
    },
    "resultRef": {
      "type": "object",
      "required": [
        "$result"
      ],
      "properties": {
        "$result": {
          "type": "string",
          "pattern": "^r[0-9]{1,3}$"
        },
        "path": {
          "type": "string",
          "pattern": "^(/([^/~]|~[01])*)*$",
          "maxLength": 200
        }
      },
      "additionalProperties": false
    },
    "renderUiInput": {
      "type": "object",
      "required": [
        "tree"
      ],
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "tree": {
          "$ref": "https://dynamic-ai/schemas/dai-ui-1.schema.json#/$defs/node"
        },
        "data": {
          "type": "object",
          "maxProperties": 16,
          "additionalProperties": {
            "oneOf": [
              {
                "$ref": "#/$defs/resultRef"
              },
              {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null",
                  "array",
                  "object"
                ],
                "not": {
                  "type": "object",
                  "required": [
                    "$result"
                  ],
                  "properties": {
                    "$result": true
                  }
                }
              }
            ]
          },
          "description": "Data model. A value is a small literal or a reference to a tool result of this turn, which the server copies in."
        },
        "suggestions": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": [
              "label",
              "text"
            ],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false,
      "description": "Arguments of the render_ui tool. The tree may only use model_safe nodes and no action props."
    },
    "primitive": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "string"
            },
            "title": {
              "type": "string",
              "maxLength": 200
            },
            "description": {
              "type": "string",
              "maxLength": 300
            },
            "minLength": {
              "type": "integer",
              "minimum": 0
            },
            "maxLength": {
              "type": "integer",
              "minimum": 1
            },
            "pattern": {
              "type": "string",
              "maxLength": 200
            },
            "format": {
              "enum": [
                "email",
                "uri",
                "date",
                "date-time"
              ]
            },
            "default": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "enum": [
                "number",
                "integer"
              ]
            },
            "title": {
              "type": "string",
              "maxLength": 200
            },
            "description": {
              "type": "string",
              "maxLength": 300
            },
            "minimum": {
              "type": "number"
            },
            "maximum": {
              "type": "number"
            },
            "default": {
              "type": "number"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "boolean"
            },
            "title": {
              "type": "string",
              "maxLength": 200
            },
            "description": {
              "type": "string",
              "maxLength": 300
            },
            "default": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "oneOf"
          ],
          "properties": {
            "type": {
              "const": "string"
            },
            "title": {
              "type": "string",
              "maxLength": 200
            },
            "description": {
              "type": "string",
              "maxLength": 300
            },
            "oneOf": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "items": {
                "type": "object",
                "required": [
                  "const",
                  "title"
                ],
                "properties": {
                  "const": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                },
                "additionalProperties": false
              }
            },
            "default": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "items"
          ],
          "properties": {
            "type": {
              "const": "array"
            },
            "title": {
              "type": "string",
              "maxLength": 200
            },
            "description": {
              "type": "string",
              "maxLength": 300
            },
            "minItems": {
              "type": "integer",
              "minimum": 0
            },
            "maxItems": {
              "type": "integer",
              "minimum": 1
            },
            "uniqueItems": {
              "const": true
            },
            "items": {
              "type": "object",
              "required": [
                "type",
                "oneOf"
              ],
              "properties": {
                "type": {
                  "const": "string"
                },
                "oneOf": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 100,
                  "items": {
                    "type": "object",
                    "required": [
                      "const",
                      "title"
                    ],
                    "properties": {
                      "const": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      },
                      "title": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "responseSchema": {
      "type": "object",
      "required": [
        "type",
        "properties",
        "additionalProperties"
      ],
      "properties": {
        "type": {
          "const": "object"
        },
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "properties": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 8,
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][A-Za-z0-9_]{0,39}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/primitive"
          }
        },
        "required": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][A-Za-z0-9_]{0,39}$"
          }
        },
        "additionalProperties": {
          "const": false
        }
      },
      "additionalProperties": false,
      "description": "Restricted JSON Schema kept with a question interrupt and used to validate the answer: a flat object of primitives, identical to the subset MCP elicitation allows, plus additionalProperties=false."
    }
  }
}
