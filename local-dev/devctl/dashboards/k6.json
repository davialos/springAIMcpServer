{
 "uid": "devctl-k6",
 "title": "devctl \u00b7 k6 load test",
 "tags": [
  "devctl",
  "k6"
 ],
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "refresh": "5s",
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "timezone": "browser",
 "templating": {
  "list": [
   {
    "name": "testid",
    "label": "Test",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "label_values(k6_vus, testid)",
     "refId": "v"
    },
    "definition": "label_values(k6_vus, testid)",
    "refresh": 2,
    "includeAll": true,
    "multi": true,
    "allValue": ".*",
    "current": {
     "selected": true,
     "text": "All",
     "value": "$__all"
    },
    "sort": 1
   }
  ]
 },
 "annotations": {
  "list": []
 },
