  {
   "id": 12,
   "type": "timeseries",
   "title": "Application logs during the test (errors / min per service)",
   "description": "Loki: correlate latency spikes with errors",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 0,
    "y": 28,
    "w": 24,
    "h": 7
   },
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "sum by (service) (count_over_time({job=\"devctl\", service!~\"build|log-shipper\"} |~ \"(?i)(error|exception|fatal)\" [1m]))",
