{
 "uid": "devctl-logs",
 "title": "devctl \u00b7 logs",
 "tags": [
  "devctl",
  "loki"
 ],
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "refresh": "10s",
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "timezone": "browser",
 "templating": {
  "list": [
   {
    "name": "service",
    "label": "Service",
    "type": "query",
    "datasource": {
     "type": "loki",
     "uid": "loki"
    },
    "query": {
     "query": "label_values({job=\"devctl\"}, service)",
     "refId": "v"
    },
    "definition": "label_values({job=\"devctl\"}, service)",
    "refresh": 2,
    "includeAll": true,
    "multi": true,
    "allValue": ".*",
    "current": {
     "selected": true,
     "text": "All",
     "value": "$__all"
    },
    "sort": 1
   },
   {
    "name": "search",
    "label": "Contains",
    "type": "textbox",
    "query": "",
    "current": {
     "text": "",
     "value": ""
    }
   }
  ]
 },
 "annotations": {
  "list": []
 },
 "panels": [
  {
   "id": 13,
   "type": "timeseries",
   "title": "Log volume by service (lines/min)",
   "description": "",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 7
   },
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "sum by (service) (count_over_time({job=\"devctl\", service=~\"$service\"} [1m]))",
     "legendFormat": "{{service}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "bars",
      "stacking": {
       "mode": "normal"
      },
      "fillOpacity": 60
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    }
   }
  },
  {
   "id": 14,
   "type": "timeseries",
   "title": "Errors & warnings (lines/min)",
   "description": "",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 7
   },
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "sum by (service) (count_over_time({job=\"devctl\", service=~\"$service\"} |~ \"(?i)(error|exception|fatal|severe)\" [1m]))",
     "legendFormat": "{{service}} error",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "sum by (service) (count_over_time({job=\"devctl\", service=~\"$service\"} |~ \"(?i)(warn)\" !~ \"(?i)(error|exception)\" [1m]))",
     "legendFormat": "{{service}} warn",
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    }
   }
  },
  {
