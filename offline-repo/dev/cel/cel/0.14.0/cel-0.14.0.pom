<project
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="http://maven.apache.org/POM/4.0.0"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <artifactId>cel</artifactId>

  <dependencies>
            <dependency>
            <groupId>com.google.auto.value</groupId>
            <artifactId>auto-value-annotations</artifactId>
            <version>1.11.1</version>
        </dependency>
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
            <version>33.6.0-jre</version>
        </dependency>
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
            <version>4.35.1</version>
        </dependency>
        <dependency>
            <groupId>com.google.re2j</groupId>
            <artifactId>re2j</artifactId>
            <version>1.8</version>
        </dependency>
        <dependency>
            <groupId>dev.cel</groupId>
            <artifactId>common</artifactId>
            <version>0.14.0</version>
        </dependency>
        <dependency>
            <groupId>dev.cel</groupId>
            <artifactId>compiler</artifactId>
            <version>0.14.0</version>
        </dependency>
        <dependency>
            <groupId>dev.cel</groupId>
            <artifactId>protobuf</artifactId>
            <version>0.14.0</version>
        </dependency>
        <dependency>
            <groupId>dev.cel</groupId>
            <artifactId>runtime</artifactId>
            <version>0.14.0</version>
        </dependency>
        <dependency>
            <groupId>dev.cel</groupId>
            <artifactId>v1alpha1</artifactId>
            <version>0.14.0</version>
        </dependency>
        <dependency>
            <groupId>org.antlr</groupId>
            <artifactId>antlr4-runtime</artifactId>
            <version>4.13.2</version>
        </dependency>
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
            <version>1.0.0</version>
        </dependency>
        <dependency>
            <groupId>org.threeten</groupId>
            <artifactId>threeten-extra</artifactId>
            <version>1.10.0</version>
        </dependency>
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
            <version>2.6</version>
        </dependency>
  </dependencies>

  <description>
    Common Expression Language for Java. This include both the compilation and runtime packages.
  </description>
  <developers>
    <developer>
      <email>cel-dev@google.com</email>
      <name>CEL Dev Team</name>
      <organization>Google</organization>
      <organizationUrl>https://google.com</organizationUrl>
    </developer>
  </developers>
  <groupId>dev.cel</groupId>
  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
    </license>
  </licenses>

  <modelVersion>4.0.0</modelVersion>
  <name>CEL Java</name>
  <packaging>jar</packaging>

  <parent>
    <artifactId>oss-parent</artifactId>
    <groupId>org.sonatype.oss</groupId>
    <version>7</version>
  </parent>

  <scm>
    <connection>scm:git:git://github.com/cel-expr/cel-java.git
    </connection>
    <url>https://github.com/cel-expr/cel-java/tree/main</url>
  </scm>

  <url>https://github.com/cel-expr/cel-java</url>

  <version>0.14.0</version>
</project>
