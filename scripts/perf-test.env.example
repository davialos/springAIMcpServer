# Example configuration for scripts/perf-test.sh (docs/tools/perf-test.md).
# Copy it per service and environment, e.g. perf/orders-staging.env, and run:
#   scripts/perf-test.sh --env-file perf/orders-staging.env [--mode stress --vus 50 …]
# The file is sourced by bash: KEY=VALUE lines, comments, and bash arrays for lists that may contain commas.
# Keep files holding secrets out of version control (*.env is a good pattern to ignore).

# ── Target (required) ──────────────────────────────────────────────────────────────────────────────────
PERF_TARGET=http://orders.staging.internal:8080          # base URL incl. context path
PERF_NAME=orders-staging                                 # results go to $PERF_OUT/$PERF_NAME/<time>-<mode>
PERF_OUT=/var/perf-results
PERF_HEALTH_PATH=/actuator/health                        # wait for the service before starting
PERF_HEADERS=("X-Tenant: acme")                         # discovery/harvest headers (array)

# ── API discovery (default: $PERF_TARGET/v3/api-docs, else /actuator/mappings) ─────────────────────────
# PERF_OPENAPI=https://orders.staging.internal:8080/v3/api-docs
# PERF_PROJECT=/srv/src/orders-service                   # sources: constraints + JPA entities
# PERF_HAR=/srv/perf/checkout-flow.har                   # browser recording → journey-<profile> modes
# PERF_INCLUDE=/api/**
# PERF_EXCLUDE="DELETE /api/**,/api/admin/**"

# ── Data source ────────────────────────────────────────────────────────────────────────────────────────
PERF_DATA_MODE=mixed                                     # auto | dummy | random | real | user | mixed
PERF_DB_URL=jdbc:postgresql://orders-db.staging.internal:5432/orders
PERF_DB_USER=orders_readonly                             # use a read-only account
# PERF_DB_SCHEMA=public
# PERF_USER_DATA=/srv/perf/orders-values.json,/srv/perf/customers.csv
# PERF_VALUES=("email=qa1@example.com,qa2@example.com")
# PERF_BINDS=("*.customerId=customers.id")
# PERF_HARVEST=true
# A service's own Spring env file works as the data source too: SPRING_DATASOURCE_URL / _USERNAME / _PASSWORD.

# ── Load (k6) ──────────────────────────────────────────────────────────────────────────────────────────
PERF_MODE=mixed-load                                     # scripts/loadtest.sh modes lists all
# PERF_VUS=20
# PERF_DURATION_SCALE=0.5
# PERF_API=getOrder,listOrders
# PERF_READ_ONLY=true
PERF_WARMUP=smoke                                        # JIT warm-up before the recording starts
# K6_BIN=/opt/k6/k6
# Stream k6 metrics to Grafana (Prometheus remote write) as well:
# K6_OUT=experimental-prometheus-rw
# K6_PROMETHEUS_RW_SERVER_URL=http://prometheus.internal:9090/api/v1/write

# ── Profiling (JFR) ────────────────────────────────────────────────────────────────────────────────────
PERF_PACKAGES=com.acme.orders,com.acme.shared            # your code, for hot-spot attribution
PERF_JVM_MATCH=orders-service                            # regex over `jcmd -l`
# Where the JVM runs (default: this machine). One of:
# PERF_SSH=deploy@orders-1.staging.internal
# PERF_SSH_OPTS="-i /home/ci/.ssh/perf -p 22"
# PERF_DOCKER=orders-service
# PERF_KUBE_POD=orders-7d9f8-abcde ; PERF_KUBE_NAMESPACE=shop ; PERF_KUBE_CONTAINER=app
# PERF_JCMD="sudo -u orders jcmd"                        # jcmd must run as the service's user
# PERF_JFR_SETTINGS=profile
# PERF_JFR_EXCEPTIONS=true
# PERF_JFR=false                                         # load only

# ── Secrets (better: export them from your secret store instead of writing them here) ─────────────────
# AUTH_TOKEN=…            # bearer token for the API (k6 and discovery)
# AUTH_USER=… AUTH_PASSWORD=… API_KEY=…
# LOADTEST_DB_PASSWORD=…
