<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.springaimcpservercommon</groupId>
        <artifactId>spring-ai-mcp-server-common-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <!--
      Opt-in, plain Java (ADR-0031): annotation-driven mock data over Datafaker, an AI fallback port with a pooled,
      budgeted implementation contract, and a virtual-thread HTTP load simulator with safety limits. Spring and Spring AI
      are wired in the autoconfigure module only.
    -->
    <artifactId>spring-ai-mcp-server-common-mockdata</artifactId>
    <packaging>jar</packaging>
    <name>springAIMcpServerCommon :: Mock data</name>
    <description>Annotation-driven mock data (Datafaker), AI fallback for gaps, and a virtual-thread load simulator. No Spring.</description>

    <properties>
        <automatic.module.name>com.springaimcpservercommon.mockdata</automatic.module.name>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.springaimcpservercommon</groupId>
            <artifactId>spring-ai-mcp-server-common-annotations</artifactId>
        </dependency>
        <dependency>
            <groupId>net.datafaker</groupId>
            <artifactId>datafaker</artifactId>
            <version>${datafaker.version}</version>
        </dependency>
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
    </dependencies>
</project>
