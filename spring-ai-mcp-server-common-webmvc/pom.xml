<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.springaimcpservercommon</groupId>
        <artifactId>spring-ai-mcp-server-common-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>spring-ai-mcp-server-common-webmvc</artifactId>
    <packaging>jar</packaging>
    <name>springAIMcpServerCommon :: Web MVC</name>
    <description>Dynamic endpoint registration, admin API, SSE streaming and problem details for servlet hosts (LLD-04/08/13).</description>

    <properties>
        <automatic.module.name>com.springaimcpservercommon.webmvc</automatic.module.name>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.springaimcpservercommon</groupId>
            <artifactId>spring-ai-mcp-server-common-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.springaimcpservercommon</groupId>
            <artifactId>spring-ai-mcp-server-common-security</artifactId>
        </dependency>
        <!-- AgentChatController and TurnEventBuffer reference AI module types (AgentInvoker, StreamEvent).
             Optional: webmvc compiles against ai but does not force it onto hosts that don't use agents. -->
        <dependency>
            <groupId>com.springaimcpservercommon</groupId>
            <artifactId>spring-ai-mcp-server-common-ai</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-core</artifactId>
        </dependency>
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-test</artifactId>
            <scope>test</scope>
        </dependency>
            <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
